{
  "name": "vamengoc-web",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive results, guided pipeline story, analysis lab and expert-meeting decks for the VA-MENGOC-BC studies",
  "type": "module",
  "scripts": {
    "data": "node scripts/copy-bundle.mjs",
    "dev": "npm run data && vite",
    "build": "npm run data && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "npm run data && vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}

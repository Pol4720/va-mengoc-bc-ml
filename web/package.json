{
  "name": "vamengoc-web",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive results, guided pipeline story, analysis lab and expert-meeting decks for the VA-MENGOC-BC studies",
  "type": "module",
  "scripts": {
    "data": "node scripts/copy-bundle.mjs",
    "dev": "npm run data && vite",
    "build": "npm run data && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "npm run data && vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
